# Supabase Project Settings → Data API / API Keys.
# Public URL and anon (or publishable) key only. VITE_* values are sent to browsers.
# Prefer the project root https://<project-ref>.supabase.co.
# The exact Data API suffix /rest/v1 or /rest/v1/ is also accepted.
# Never use a service_role or secret key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public Turnstile site key. Required only to CREATE a new game.
VITE_TURNSTILE_SITE_KEY=

# Server-only Supabase Function Secrets (never VITE_*, never commit values):
# TURNSTILE_SECRET_KEY
# TURNSTILE_ALLOWED_HOSTNAMES (comma-separated exact hostnames, no scheme/path)
